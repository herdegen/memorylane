<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Sur l'hôte de prod, `php artisan optimize` met en cache la config
             PROD : on force des chemins de cache propres aux tests pour que
             ces <env> s'appliquent toujours (sinon les tests tournent contre
             la base de prod). Voir aussi Tests\TestCase::createApplication. -->
        <env name="APP_CONFIG_CACHE" value="/tmp/memorylane-tests-config.php" force="true"/>
        <env name="APP_ROUTES_CACHE" value="/tmp/memorylane-tests-routes.php" force="true"/>
        <env name="APP_EVENTS_CACHE" value="/tmp/memorylane-tests-events.php" force="true"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- Pas de journal : les tests lancés sur le serveur polluaient laravel.log -->
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <!-- Moteur de visages des tests : indépendant du .env (InsightFaceTest le change lui-même) -->
        <env name="FACES_ENGINE" value="faceapi" force="true"/>
        <env name="FACES_AUTO_MATCH" value="false" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_DATABASE" value="memorylane_test" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SCOUT_DRIVER" value="database" force="true"/>
        <env name="SCOUT_QUEUE" value="false" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
