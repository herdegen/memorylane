# Configuration de MemoryLane (installation chez soi).
# Créé par install.sh, complété par l'assistant d'installation (/install).
# Après une modification à la main :
#   docker compose exec app php artisan optimize
#   docker compose restart app horizon scheduler

# --- Application -------------------------------------------------------------
APP_NAME=MemoryLane
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=__APP_URL__
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
# Mode des nouveaux cercles : family (arbre, généalogie) ou friends
MEMORYLANE_MODE=family

# --- Services internes (Docker) -------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=memorylane
DB_USERNAME=memorylane
DB_PASSWORD=__DB_PASSWORD__

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=43200
# Noms fixes : sinon ils suivent APP_NAME, et renommer le site déconnecte tout
# le monde et vide le cache et les files d'attente.
SESSION_COOKIE=memorylane_session
REDIS_PREFIX=memorylane_database_
CACHE_PREFIX=memorylane_cache_
HORIZON_PREFIX=memorylane_horizon:
# true quand le site est servi en HTTPS (réglé par l'assistant)
SESSION_SECURE_COOKIE=false

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=__MEILI_KEY__
MEILI_NO_ANALYTICS=true

# --- Photos et vidéos (stockage S3) -------------------------------------------
# Par défaut : stockage intégré à ce serveur (Garage). Les noms SCALEWAY_*
# valent pour n'importe quel fournisseur S3 (Scaleway, OVH, Backblaze, AWS…).
FILESYSTEM_DISK=scaleway
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_REGION=garage
SCALEWAY_BUCKET=memorylane-files
SCALEWAY_ENDPOINT=http://garage:3900
SCALEWAY_URL=
# Stockage intégré seulement : adresse du site (les fichiers passent par nginx)
SCALEWAY_PUBLIC_URL=__APP_URL__
# Clés du stockage intégré (gardées pour pouvoir y revenir)
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# --- E-mails -------------------------------------------------------------------
# log = aucun e-mail envoyé (écrits dans storage/logs) ; smtp = envoi réel
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=memorylane@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Reconnaissance des visages ------------------------------------------------
# insightface = service « faces » sur ce serveur ; faceapi = dans le navigateur
FACES_ENGINE=faceapi
FACES_AUTO_MATCH=false

# --- Documents et lieux -------------------------------------------------------
# Lecture du texte des documents photographiés (Tesseract, sur ce serveur)
DOCUMENTS_OCR=true
# Lieux situés automatiquement sur la carte dès leur saisie (OpenStreetMap :
# seul le nom du lieu est envoyé) ; false = seulement à la main
# (php artisan people:geocode-places)
GEOCODE_AUTO=true

# --- Notifications sur téléphone (HTTPS obligatoire) ---------------------------
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Import Google Photos / Google Drive (facultatif) --------------------------
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
GOOGLE_DRIVE_API_KEY=

# --- Sauvegarde chiffrée vers un stockage distant (facultatif) -----------------
BACKUP_SRC_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_SALT=

# --- Supervision (facultatif) : adresse « ping » appelée chaque heure ----------
HEALTHCHECK_PING_URL=

# --- Journaux --------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
BROADCAST_DRIVER=log
VITE_APP_NAME="${APP_NAME}"
