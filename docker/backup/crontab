# Heures UTC (le conteneur n'a pas de fuseau). Le dump de la base part à
# 02:45 heure de Paris, soit 00:45 UTC l'été et 01:45 UTC l'hiver : la copie
# passe à 02:30 UTC, après lui en toute saison.
30 2 * * * sh /usr/local/bin/backup.sh copy > /proc/1/fd/1 2>&1
# Test de restauration le 1er du mois, une fois la copie de la nuit finie.
0 4 1 * * sh /usr/local/bin/backup.sh verify > /proc/1/fd/1 2>&1
